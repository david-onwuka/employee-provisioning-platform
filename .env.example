# n8n provisioning security
PROVISIONING_SECRET=replace_with_local_secret
PROVISIONING_SECRET_REQUIRED=true

# Apache Superset
SUPERSET_ADMIN_USERNAME=replace_with_superset_admin_username
SUPERSET_ADMIN_PASSWORD=replace_with_superset_admin_password

# Target application API credentials
# Store actual credentials only in your local environment / n8n credentials.
# Never commit real API keys, tokens, passwords, or secrets.
