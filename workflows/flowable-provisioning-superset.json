{
  "name": "Superset Account Provisioning",
  "nodes": [
    {
      "parameters": {
        "content": "## Account Provisioning Template\n\nThis is the shared base workflow for account provisioning.\n\nBefore using this template:\n- Set PROVISIONING_SECRET in the local n8n environment.\n- Keep PROVISIONING_SECRET_REQUIRED=true by default.\n- A local-only bypass is available by setting PROVISIONING_SECRET_REQUIRED=false.\n- Never use the bypass on shared, dev, or sandbox instances.\n\nCustomize the \"Create Account\" node for the target tool, then activate the workflow and configure its webhook URL in the Tool Registry.\n\nThe password is generated by the application and included in the request body as password. Use it when creating the account instead of generating your own.\n\nSee docs/provisioning/README.md in the app repo for the full request/response contract.",
        "height": 240,
        "width": 340
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -680,
        -260
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000001",
      "name": "Read Me"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "provision-account",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000002",
      "name": "Webhook",
      "webhookId": "9f6a1b1e-0000-4000-8000-000000000002"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check-secret-bypass",
              "leftValue": "={{ $env.PROVISIONING_SECRET_REQUIRED || 'true' }}",
              "rightValue": "false",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "check-secret-header",
              "leftValue": "={{ $json.headers['x-provisioning-key'] }}",
              "rightValue": "={{ $env.PROVISIONING_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -440,
        0
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000003",
      "name": "Check Secret"
    },
    {
      "parameters": {
        "content": "## Customize me\n\nReplace with a real call to the target tool's admin API to create the account. Use `{{$json.body.employeeName}}`, `{{$json.body.employeeEmail}}`, `{{$json.body.password}}`, etc.; see the README for the full payload shape. If the target tool returns its own username (not always the email), read that from the response here instead of assuming email.",
        "height": 240,
        "width": 280
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -280
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000004",
      "name": "Customize: create the account"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "shape-username",
              "name": "username",
              "value": "={{ $('Webhook').item.json.body.employeeEmail }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        40,
        0
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000006",
      "name": "Shape Response"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"username\": $json.username } }}",
        "options": {
          "responseCode": 201
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        280,
        0
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000007",
      "name": "Respond: Success"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Unauthorized\" } }}",
        "options": {
          "responseCode": 401
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -440,
        220
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000008",
      "name": "Respond: Unauthorized"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8088/api/v1/security/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"username\": $env.SUPERSET_ADMIN_USERNAME, \"password\": $env.SUPERSET_ADMIN_PASSWORD, \"provider\": \"db\", \"refresh\": false } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        0
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000009",
      "name": "Superset Login"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8088/api/v1/security/users/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"username\": $('Webhook').item.json.body.employeeEmail, \"first_name\": $('Webhook').item.json.body.employeeName, \"last_name\": \"\", \"email\": $('Webhook').item.json.body.employeeEmail, \"password\": $('Webhook').item.json.body.password, \"active\": true, \"roles\": [3] } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        0
      ],
      "id": "9f6a1b1e-0000-4000-8000-000000000005",
      "name": "Create Superset Account"
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Check Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Secret": {
      "main": [
        [
          {
            "node": "Superset Login",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: Unauthorized",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Account (customize)": {
      "main": [
        [
          {
            "node": "Shape Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Response": {
      "main": [
        [
          {
            "node": "Respond: Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Superset Login": {
      "main": [
        [
          {
            "node": "Create Superset Account",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Superset Account": {
      "main": [
        [
          {
            "node": "Shape Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "provisioning-template",
  "tags": []
}